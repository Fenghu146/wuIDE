#!/usr/bin/env bash

# Checks the shared checkout is safe to merge into or release from.
# Usage: script/pre-merge-check
#
# Prints PASS or FAIL for each check and exits non-zero if any of them failed.
# Run it before merging, tagging, or cutting a release. Nothing is deleted or
# fixed automatically. See docs/PARALLEL-DEV.md.

set -euo pipefail

cd "$(dirname "$0")/.."

min_free_gb=${PRE_MERGE_MIN_FREE_GB:-60}
failed=0

pass() { printf 'PASS  %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*"; failed=1; }
note() { printf '      %s\n' "$*"; }
section() { printf '\n== %s. %s ==\n' "$1" "$2"; }

# git worktree list puts the primary worktree first; it is the shared one that
# merges, releases, and tags are done from.
main_worktree=$(git worktree list --porcelain | sed -n 's/^worktree //p' | head -1)

section 1 "main checkout has no uncommitted changes"
dirty=$(git -C "$main_worktree" status --short)
if [[ -z "$dirty" ]]; then
    pass "clean: $main_worktree"
else
    fail "uncommitted changes in $main_worktree"
    while IFS= read -r line; do note "$line"; done <<< "$dirty"
    note "Hand them back to the thread that made them."
    note "Never clean up someone else's work with checkout, stash, revert, or reset."
fi

section 2 "no worktree is left on a branch already merged into main"
# Compare against local main rather than origin/main so this check does not need
# the network; check 3 reports when local main is stale.
base=main
git rev-parse --quiet --verify "refs/heads/$base" >/dev/null || base=origin/main
base_tip=$(git rev-parse "$base")

# The worktree this script runs from is in use by definition; do not tell its
# own thread to delete it.
current=$(cd "$(git rev-parse --show-toplevel)" && pwd -P)

residue=""
detached=""
path=""
index=0
while IFS= read -r line; do
    case "$line" in
        "worktree "*)
            path=${line#worktree }
            index=$((index + 1))
            ;;
        "branch "*)
            branch=${line#branch }
            name=${branch#refs/heads/}
            here=""
            if [[ -d "$path" ]]; then
                here=$(cd "$path" && pwd -P) || here=""
            fi
            # A branch still sitting on the tip of main has no commits of its
            # own yet, so there is nothing merged to clean up.
            if ((index > 1)) && [[ "$name" != "main" ]] && [[ "$here" != "$current" ]] &&
                [[ "$(git rev-parse "$branch" 2>/dev/null)" != "$base_tip" ]] &&
                git merge-base --is-ancestor "$branch" "$base" 2>/dev/null; then
                residue+="$path ($name)"$'\n'
            fi
            path=""
            ;;
        "")
            # A block with no branch line is a detached HEAD; we cannot tell
            # whether its branch is merged, so report it instead of guessing.
            if [[ -n "$path" ]] && ((index > 1)); then
                detached+="$path"$'\n'
            fi
            path=""
            ;;
    esac
done < <(git worktree list --porcelain)

if [[ -z "$residue" ]]; then
    pass "every worktree is on work that is not in $base yet"
else
    count=$(printf '%s' "$residue" | grep -c .)
    fail "$count worktree(s) sit on branches already merged into $base"
    while IFS= read -r line; do note "$line"; done <<< "${residue%$'\n'}"
    note "Remove them once their owner is done: git worktree remove <path>"
fi
while IFS= read -r line; do
    if [[ -n "$line" ]]; then
        note "detached HEAD, not checked: $line"
    fi
done <<< "$detached"

section 3 "local main matches origin/main"
if ! git fetch --quiet origin; then
    fail "git fetch origin failed; cannot compare main with origin/main"
elif ! git rev-parse --quiet --verify "refs/remotes/origin/main" >/dev/null; then
    fail "origin/main does not exist"
elif [[ "$(git rev-parse main)" == "$(git rev-parse origin/main)" ]]; then
    pass "main and origin/main are both $(git rev-parse --short=9 main)"
else
    read -r ahead behind < <(git rev-list --left-right --count main...origin/main)
    if [[ "$ahead" != 0 && "$behind" != 0 ]]; then
        fail "main is $ahead commit(s) ahead of and $behind behind origin/main"
    elif [[ "$ahead" != 0 ]]; then
        fail "main is $ahead commit(s) ahead of origin/main; push it"
    else
        fail "main is $behind commit(s) behind origin/main; fast-forward it"
    fi
    note "Fix this before merging, tagging, or releasing."
fi

section 4 "at least $min_free_gb GB free where the repo lives"
volume=""
avail_kb=""
while read -r fs _ _ available _; do
    volume=$fs
    avail_kb=$available
done < <(df -Pk . | tail -n +2)

if [[ -z "$avail_kb" ]]; then
    fail "could not read free disk space with df"
else
    free_gb=$(awk -v kb="$avail_kb" 'BEGIN { printf "%.1f", kb / 1048576 }')
    if ((avail_kb >= min_free_gb * 1024 * 1024)); then
        pass "$free_gb GB free on $volume"
    else
        fail "only $free_gb GB free on $volume, need $min_free_gb GB"
        note "A release-fast build needs 25-30 GB and can grow while linking."
        note "Large shared target dirs are the usual cause; clear the ones you own."
    fi
fi

section 5 "no cargo or rustc process is running"
builders=""
listed=true
case "$(uname -s)" in
    MINGW* | MSYS* | CYGWIN*)
        # Git Bash has no pgrep, so ask Windows for the process list.
        powershell=$(command -v powershell.exe || command -v powershell || true)
        if [[ -z "$powershell" ]]; then
            listed=false
            fail "cannot list processes: PowerShell is not on PATH"
        else
            builders=$(
                "$powershell" -NoProfile -NonInteractive -Command \
                    'Get-Process -Name cargo,rustc -ErrorAction SilentlyContinue | ForEach-Object { "[{0}] {1}" -f $_.Id, $_.ProcessName }' \
                    2>/dev/null || true
            )
        fi
        ;;
    *)
        builders=$(ps -A -o pid=,comm= 2>/dev/null | awk '$2 ~ /(^|\/)(cargo|rustc)$/ { print "[" $1 "] " $2 }' || true)
        ;;
esac
# PowerShell writes CRLF, so drop the carriage returns before printing.
builders=${builders//$'\r'/}

if [[ "$listed" == true ]]; then
    if [[ -z "$builders" ]]; then
        pass "none running"
    else
        fail "a build is running; wait for it or you will share its target dir"
        while IFS= read -r line; do note "$line"; done <<< "$builders"
    fi
fi

printf '\n'
if ((failed == 0)); then
    echo "All checks passed."
else
    echo "Some checks failed. Resolve them before merging, tagging, or releasing." >&2
fi
exit "$failed"
