#!/usr/bin/env bash

set -euo pipefail

CARGO_ABOUT_VERSION="0.8.2"
OUTPUT_FILE="${1:-$(pwd)/assets/licenses.md}"
TEMPLATE_FILE="script/licenses/template.md.hbs"
# `cargo about` gathers licenses through `cargo metadata`, which fetches the
# lockfile's git dependencies with its output captured: when that fetch stalls,
# nothing is printed at all. 1.4.7's bundle_mac (aarch64) sat on "Generating
# cargo licenses" for 4h55m until GitHub's 300-minute job timeout cancelled the
# job and skipped the release, while the other four platforms finished the same
# step from the same lockfile. Bound it, so a stalled fetch fails the job in 20
# minutes with a line that says so instead of burning the whole job timeout.
LICENSES_TIMEOUT_SECONDS="${LICENSES_TIMEOUT_SECONDS:-1200}"

fail_on_stderr() {
    local tmpfile=$(mktemp)
    "$@" 2> >(tee "$tmpfile" >&2)
    local rc=$?
    [ -s "$tmpfile" ] && rc=1
    rm "$tmpfile"
    return $rc
}

# Run "$@" in its own process group and kill the group once it has outlived the
# limit, so a stalled `cargo about` and the `cargo` it started both die and the
# script fails. `timeout(1)` is not on every runner (macOS ships none), so this
# stays in bash. `set -m` gives the background job a process group of its own.
run_bounded() {
    local limit="$1"
    shift
    local pid watchdog
    local rc=0
    set -m
    "$@" &
    pid=$!
    set +m
    (
        local waited=0
        while [ "$waited" -lt "$limit" ] && kill -0 "$pid" 2>/dev/null; do
            sleep 5
            waited=$((waited + 5))
        done
        kill -0 "$pid" 2>/dev/null || exit 0
        printf 'licenses generation stalled; see the cargo about output above (killed after %ss)\n' "$limit" >&2
        kill -TERM -"$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
        sleep 5
        kill -KILL -"$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
    ) &
    watchdog=$!
    wait "$pid" || rc=$?
    kill "$watchdog" 2>/dev/null || true
    wait "$watchdog" 2>/dev/null || true
    return "$rc"
}

echo -n "" >"$OUTPUT_FILE"

{
    echo -e "# ###### THEME LICENSES ######\n"
    cat assets/themes/LICENSES

    echo -e "\n# ###### ICON LICENSES ######\n"
    cat assets/icons/LICENSES

    echo -e "\n# ###### CODE LICENSES ######\n"
} >>"$OUTPUT_FILE"

if ! cargo about --version | grep "cargo-about $CARGO_ABOUT_VERSION" &>/dev/null; then
    echo "Installing cargo-about@$CARGO_ABOUT_VERSION..."
    cargo install "cargo-about@$CARGO_ABOUT_VERSION"
else
    echo "cargo-about@$CARGO_ABOUT_VERSION is already installed."
fi

echo "Generating cargo licenses"
if [ -z "${ALLOW_MISSING_LICENSES-}" ]; then FAIL_FLAG=--fail; else FAIL_FLAG=""; fi
if [ -z "${ALLOW_MISSING_LICENSES-}" ]; then WRAPPER=fail_on_stderr; else WRAPPER=""; fi
set -x
run_bounded "$LICENSES_TIMEOUT_SECONDS" $WRAPPER cargo about generate \
    $FAIL_FLAG \
    -c script/licenses/zed-licenses.toml \
    "$TEMPLATE_FILE" >>"$OUTPUT_FILE"
set +x

sed -i.bak 's/&quot;/"/g' "$OUTPUT_FILE"
sed -i.bak 's/&#x27;/'\''/g' "$OUTPUT_FILE" # The ` '\'' ` thing ends the string, appends a single quote, and re-opens the string
sed -i.bak 's/&#x3D;/=/g' "$OUTPUT_FILE"
sed -i.bak 's/&#x60;/`/g' "$OUTPUT_FILE"
sed -i.bak 's/&lt;/</g' "$OUTPUT_FILE"
sed -i.bak 's/&gt;/>/g' "$OUTPUT_FILE"

rm -rf "${OUTPUT_FILE}.bak"

echo "generate-licenses completed. See $OUTPUT_FILE"
