#!/usr/bin/env bash

# Guards the hooks against running text out of their own messages.
#
# A heredoc expands unless its delimiter is quoted, so an unquoted <<EOF whose
# body shows a command in backticks runs that command. That happened here: the
# main-checkout guard printed "A clean `git merge` does not run this hook at
# all", so bash ran `git merge` on every refused commit. A stale local main
# would have been fast-forwarded by nothing more than somebody trying to commit.
#
# The fake git below records every invocation. It has to be exercised by running
# the hook directly: git prepends its own directories when it runs a hook, so a
# fake git placed first on PATH is never reached by a real commit.
#
# Usage: script/hook-test
# Exit status is non-zero if any case failed.

set -uo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd -P)
real_git=$(command -v git)

passed=0
failed=0

ok() { passed=$((passed + 1)); printf 'PASS  %s\n' "$1"; }
no() {
    failed=$((failed + 1))
    printf 'FAIL  %s\n' "$1"
    if [[ -n "${2:-}" ]]; then printf '%s\n' "$2" | sed 's/^/      /'; fi
}

tmp=$(mktemp -d "${TMPDIR:-/tmp}/hook-test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

git init -q "$tmp/repo"
cd "$tmp/repo" || exit 1
git config user.email hook@example.com
git config user.name hook-test
mkdir -p .githooks
cp "$repo_root/.githooks/pre-commit" .githooks/pre-commit
chmod +x .githooks/pre-commit
git config core.hooksPath .githooks
printf 'a\n' >a.txt
git add -A
AMP_MAIN_COMMIT=1 git commit -qm init

echo "== a real commit in the main checkout =="
printf 'b\n' >>a.txt
git add a.txt
out=$(git commit -qm second 2>&1)
status=$?

if ((status != 0)) && [[ "$out" == *"shared main checkout"* ]]; then
    ok "a hand-made commit in the main checkout is refused"
else
    no "a hand-made commit in the main checkout is refused" "$out"
fi

# The symptom of the bug: a command the hook ran for its message fails and leaks
# its error. Wording-tolerant on purpose.
if [[ "$out" != *"fatal:"* ]]; then
    ok "the refusal prints no error from a command it ran"
else
    no "the refusal prints no error from a command it ran" "$out"
fi

echo
echo "== which git commands the hook actually runs =="

mkdir -p "$tmp/bin"
cat >"$tmp/bin/git" <<FAKE
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$tmp/calls.log"
case "\${1:-}" in
    merge | rebase | reset | checkout | switch | commit | push | pull | fetch | cherry-pick | am | apply | stash)
        printf 'fake git: refused to run %s\n' "\$1" >&2
        exit 1
        ;;
esac
exec "$real_git" "\$@"
FAKE
chmod +x "$tmp/bin/git"

: >"$tmp/calls.log"
out=$(PATH="$tmp/bin:$PATH" ./.githooks/pre-commit 2>&1)
status=$?

if ((status != 0)) && [[ "$out" == *"shared main checkout"* ]]; then
    ok "the hook refuses when run on its own"
else
    no "the hook refuses when run on its own" "$out"
fi

if grep -qx 'merge' "$tmp/calls.log"; then
    no "the hook does not run git merge" "$(cat "$tmp/calls.log")"
else
    ok "the hook does not run git merge"
fi

# A stronger form of the same idea: any subcommand outside this list means the
# hook ran something nobody asked it to. Extend the list deliberately.
unexpected=$(awk '{ print $1 }' "$tmp/calls.log" | grep -vx -e rev-parse -e worktree | sort -u)
if [[ -z "$unexpected" ]]; then
    ok "the hook runs only the git commands it needs"
else
    no "the hook runs only the git commands it needs" "$(printf 'unexpected: %s\n--- all calls ---\n%s' "$unexpected" "$(cat "$tmp/calls.log")")"
fi

echo
printf '%d passed, %d failed\n' "$passed" "$failed"
((failed == 0))
